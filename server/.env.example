NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173,https://pizza-paradise-gamma.vercel.app

# Supabase: Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# service_role key is SECRET: server only, never in the React app
SUPABASE_SERVICE_ROLE_KEY=

# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Used only by `npm run seed` to create the admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
